{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification-input-v2",
  "description": "Serialized verifier invocation containing exact input bytes, caller-selected policy bytes, and explicit evaluation context.",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        2
      ]
    },
    "inputs": {
      "description": "Untrusted evidence and reference bytes encoded for JSON transport; verification establishes which claims are authenticated.",
      "type": "object",
      "properties": {
        "report": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "amd_chain": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "vcek": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "reference": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "report",
        "amd_chain",
        "vcek",
        "reference"
      ],
      "additionalProperties": false
    },
    "policy": {
      "description": "Exact caller-selected verifier-policy JSON bytes encoded as base64.",
      "type": "string",
      "contentEncoding": "base64"
    },
    "context": {
      "description": "Expected nonce and evaluation time supplied independently by the caller; live freshness and nonce reuse remain caller responsibilities.",
      "type": "object",
      "properties": {
        "expected_nonce_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "evaluation_unix_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        }
      },
      "required": [
        "expected_nonce_base64",
        "evaluation_unix_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "inputs",
    "policy",
    "context"
  ],
  "additionalProperties": false
}
