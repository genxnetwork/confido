{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verifier-policy-v2",
  "description": "Caller-selected platform requirements and immutable reference pin consumed by the Confido evidence verifier.",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        2
      ]
    },
    "profile": {
      "enum": [
        "azure-snp-vtpm-ima/1"
      ]
    },
    "platform": {
      "description": "Locally enrolled AMD product, root, launch measurement, and minimum TCB requirements.",
      "type": "object",
      "properties": {
        "product": {
          "description": "Supported AMD product selected by the local policy and checked against authenticated evidence.",
          "enum": [
            "Milan",
            "Genoa"
          ]
        },
        "ark_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "launch_measurement": {
          "type": "string",
          "pattern": "^[a-f0-9]{96}$"
        },
        "minimum_tcb": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "product",
        "ark_sha256",
        "launch_measurement",
        "minimum_tcb"
      ],
      "additionalProperties": false
    },
    "reference": {
      "description": "Exact repository, commit, path, and SHA-256 pin for the reference bytes; publisher approval is a separate caller decision.",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "commit",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "profile",
    "platform",
    "reference"
  ],
  "additionalProperties": false
}
