{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "application-decision-v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        2
      ]
    },
    "application_admitted": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "application_admitted",
    "reason"
  ],
  "additionalProperties": false
}
