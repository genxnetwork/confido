{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:confido:appraisal-result:1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "reason",
    "profile",
    "wire_version",
    "mode",
    "evaluated_at",
    "origin",
    "service_id",
    "checks",
    "evidence_sha256",
    "nonce",
    "certificate_sha256",
    "vtpm_key_sha256",
    "reference",
    "coverage",
    "bindings",
    "timings_ms",
    "limitations",
    "application_admitted"
  ],
  "properties": {
    "reason": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "passed",
        "invalid_evidence",
        "policy_mismatch",
        "unsupported_profile",
        "dependency_unavailable"
      ]
    },
    "profile": {
      "const": "azure-snp-vtpm-ima/1"
    },
    "wire_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "live",
        "historical_replay"
      ]
    },
    "evaluated_at": {
      "type": "integer"
    },
    "application_admitted": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "status",
          "reason",
          "detail"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "path",
        "sha256"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object"
    },
    "bindings": {
      "type": "object"
    },
    "timings_ms": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "certificate_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "vtpm_key_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonce": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "historical_replay"
          }
        }
      },
      "then": {
        "properties": {
          "application_admitted": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "application_admitted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "passed"
          },
          "mode": {
            "const": "live"
          }
        }
      }
    }
  ]
}
