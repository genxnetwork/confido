[Unit]
Description=Confido Server Service
After=network.target
Before=nginx.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /etc/nginx/certs /var/log/nginx
ExecStartPre=/bin/sh -c 'if ! mountpoint -q /etc/nginx/certs; then mount -t tmpfs -o size=8M tmpfs /etc/nginx/certs; fi'
ExecStart=/usr/local/bin/confido-server 127.0.0.1:8080 /etc/nginx/certs sha1
User=root
Restart=on-failure

[Install]
WantedBy=multi-user.target
