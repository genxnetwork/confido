[Unit]
Description=Confido Server Service
After=network.target
Before=nginx.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /etc/nginx/certs
ExecStartPre=/bin/sh -c 'if ! mountpoint -q /etc/nginx/certs; then mount -t tmpfs -o size=8M tmpfs /etc/nginx/certs; fi'
ExecStart=/root/confido/server/target/debug/confido_server 127.0.0.1:8080 /etc/nginx/certs
User=root
Restart=on-failure

[Install]
WantedBy=multi-user.target
